(version 1)

# Eve's board geometry and reliability rules.
#
# Paste the rules you want into <project>.kicad_dru. Every rule here is a check that
# would otherwise have to be done by eye, which is exactly what Eve does not want.

# --- Guard ring and board edge ----------------------------------------------------
#
# The guard ring itself cannot be proven by DRC: "a GND ring exists all around the
# board" is a topology claim, not a clearance claim. What DRC can enforce is that
# nothing violates the edge clearance the ring needs to live in. Checking that the
# ring is present and GND on every layer stays a review step.

(rule "Edge clearance, all copper layers"
  (severity error)
  (condition "A.Type == 'Track' || A.Type == 'Via' || A.Type == 'Pad' || A.Type == 'Zone'")
  (constraint edge_clearance (min 0.5mm))
)

# --- Vias ------------------------------------------------------------------------

(rule "Via too close to pad"
  (severity error)
  (condition "A.Type == 'Pad' && B.Type == 'Via'")
  (constraint physical_hole_clearance (min 0.102mm))
)

# GND pads should have a GND via nearby for a short return path. Reported as the
# absence of a close via: the first rule excludes the pairs that are fine, the
# second asserts on what is left.
(rule "GND via close to pad, exclusion"
  (severity ignore)
  (condition "A.Type == 'Pad' && A.NetName == 'GND' && B.Type == 'Via' && B.NetName == 'GND'")
  (constraint physical_clearance (min 0.8mm))
)

(rule "No GND via close enough to GND pad"
  (severity warning)
  (condition "A.Type == 'Pad' && A.NetName == 'GND' && B.Type == 'Via' && B.NetName == 'GND'")
  (constraint assertion "A.Type == 'Pad'")
)

# --- Assembly: selective wave soldering -------------------------------------------
#
# Keep soldermask openings away from through-hole pads, so a selective wave process
# cannot bridge onto them. Eve's 4 mm rule is directional (the side opposite the
# through-hole connectors); DRC has no notion of "side", so this enforces the
# omnidirectional part of the intent.

(rule "Through-hole pad to soldermask opening"
  (severity warning)
  (layer outer)
  (condition "A.Pad_Type == 'Through-hole' && B.Type == 'Pad' && B.Pad_Type == 'SMD'")
  (constraint hole_clearance (min 2.1mm))
)

# --- Testpoints -------------------------------------------------------------------
#
# Probes must not hit tall neighbours and solder must not run onto the pad. Tag
# testpoint footprints into a group or give them a TP* reference, then narrow the
# condition below; as written it applies to every testpoint footprint whose
# reference starts with TP.

(rule "Testpoint away from through-hole pads"
  (severity warning)
  (layer outer)
  (condition "A.Reference == 'TP*' && B.Pad_Type == 'Through-hole'")
  (constraint physical_clearance (min 2.0mm))
)
